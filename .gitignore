# ==========================================
# TESLOKA CBT - Public Release .gitignore
# Repositori Publik GitHub (Distribusi Obfuskasi)
# ==========================================

# 1. Environment & Local Credentials
.env
.env.backup
.env.production
.env.local
.env.*.local
.env.testing
.env.testing.local
!.env.example
Homestead.json
Homestead.yaml
auth.json
.npmrc.local

# 2. Secret Keys, Certificates & Security Credentials
*.key
*.pem
*.crt
*.cer
*.pfx
*.p12
*.der
id_rsa*
id_ed25519*
oauth-private.key
oauth-public.key

# 3. Dependencies & Package Managers
/vendor/
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# 4. Storage & Application Runtime (CBT Security & Isolation)
/public/storage
/storage/*.key
/storage/pail/
/storage/debugbar/
/storage/clockwork/
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitignore
!/storage/app/private/
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/cache/locks/*
!/storage/framework/cache/locks/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
*.log

# 5. Dev Server Artifacts
/public/hot
/public/fonts-manifest.dev.json
.vite/

# 6. Bootstrap Cache
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# 7. Database Dumps & Local Database Files
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
dump.rdb
*.sql
*.dump
database/*.sql
database/*.dump
database/*.sqlite

